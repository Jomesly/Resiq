ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://resiq:resiq-local-only@127.0.0.1:54329/resiq
# Generate a private value for deployment: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGNING_SECRET=resiq-development-only-change-before-deploying
PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_BACKEND=local
STORAGE_ROOT=data
OCR_ENGINE=paddle
CPU_THREADS=2
OCR_TIMEOUT_S=90
LEASE_S=120
MAX_WORKSPACES=1000
MAX_RECEIPTS_TOTAL=10000
MAX_PENDING_TOTAL=100
REQUESTS_PER_IP_PER_MINUTE=600
REQUESTS_PER_MINUTE=6000
CLEANUP_GRACE_S=86400
MAINTENANCE_INTERVAL_S=300
# Required private value in production; protects /ops/status (not public at the gateway).
OPERATIONS_TOKEN=
# S3 alternative (standard AWS environment credentials; never NEXT_PUBLIC variables):
# STORAGE_BACKEND=s3
# S3_BUCKET=resiq-private
# S3_REGION=auto
# S3_ENDPOINT_URL=https://your-object-storage-endpoint
