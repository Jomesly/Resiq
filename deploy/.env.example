# Copy to deploy/.env.production, then generate the three secrets below.
DOMAIN=receipts.example.com
POSTGRES_PASSWORD=
SIGNING_SECRET=
OPERATIONS_TOKEN=
# Used in every image tag; retain the previous tag for rollback.
RELEASE_TAG=local
OCR_ENGINE=paddle
WORKER_TARGET=paddle
MAX_WORKSPACES=1000
MAX_RECEIPTS_TOTAL=10000
MAX_PENDING_TOTAL=100
# Dedicated subnet used ONLY between Caddy and the rate-limiting gateway.
EDGE_SUBNET=172.30.71.0/24
