limit_req_zone $binary_remote_addr zone=api_ip:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=signup_ip:10m rate=2r/m;
limit_req_zone $server_name zone=api_global:1m rate=100r/s;
limit_conn_zone $binary_remote_addr zone=connections:10m;
server {
    listen 8080;
    server_tokens off;
    # This network contains only Caddy and this gateway. Caddy replaces untrusted forwarding headers.
    set_real_ip_from ${EDGE_SUBNET};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 11m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 30s;
    limit_conn connections 20;
    limit_req_status 429;
    access_log off;
    # Resolve container replacements without restarting the gateway.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://api:8000;
    set $frontend http://frontend:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    location = /api/workspaces {
        limit_req zone=signup_ip burst=5 nodelay;
        limit_req zone=api_global burst=100 nodelay;
        proxy_pass $api;
    }
    location /api/ {
        limit_req zone=api_ip burst=60 nodelay;
        limit_req zone=api_global burst=100 nodelay;
        proxy_pass $api;
    }
    location = /healthz { proxy_pass $api; }
    location = /readyz { proxy_pass $api; }
    location /ops/ { return 404; }
    location / {
        proxy_pass $frontend;
        proxy_buffering off;
    }
}
